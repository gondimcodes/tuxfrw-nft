[Unit]
Description=TuxFrw-NFT Automated Firewall Service
Documentation=https://github.com/gondimcodes/tuxfrw-nft
DefaultDependencies=no
After=network-pre.target systemd-udevd.service network.target
Before=shutdown.target fail2ban.service
Wants=network.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/tuxfrw-nft start
ExecStop=/usr/sbin/tuxfrw-nft stop
ExecReload=/usr/sbin/tuxfrw-nft restart

[Install]
WantedBy=multi-user.target
